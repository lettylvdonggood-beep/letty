export default function App() {
  const [view, setView] = useState("desk");
  const [show, setShow] = useState(true);
  const go = (v) => { setShow(false); setTimeout(() => { setView(v); window.scrollTo(0, 0); setShow(true); }, 280); };
  return (
    <>
      <style>{FONTS}</style>
      <div style={{ opacity: show ? 1 : 0, transition: "opacity 0.28s ease" }}>
        {view === "desk" && <Desk open={(id) => go(id)} />}
        {view === "agent" && <Agent back={() => go("desk")} />}
        {view === "noise" && <Noise back={() => go("desk")} />}
      </div>
    </>
  );
}
